{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jouzu Desktop",
  "version": "../package.json",
  "identifier": "ai.shisa.jouzu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "additionalWatchFolders": [
      "../../../packaging/launcher"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Jouzu",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "create": false,
        "decorations": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Shisa, Inc.",
    "copyright": "Copyright © Shisa, Inc.",
    "windows": {
      "nsis": {
        "template": "../../../packaging/launcher/installer.nsi",
        "installerHooks": "../../../packaging/launcher/desktop-installer-hooks.nsh",
        "languages": [
          "English",
          "Japanese",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMkRDRUI5QkY5NTk5MEMKUldRTW1aVy91YzR0c015QWNjb21vdVFTMjBpaWJ2TWRkMnFBTElGaEpVelNJVnkyMG14Tm1iM3AK",
      "endpoints": [
        "https://github.com/sabishii-me/jouzu-desktop/releases/download/desktop-update/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}

